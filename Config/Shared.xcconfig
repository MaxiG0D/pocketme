// Set your Apple Developer Team ID and identifiers before running on a device.
DEVELOPMENT_TEAM =
BUNDLE_ID_PREFIX = com.maxigariepy.pocketme
APP_GROUP_IDENTIFIER = group.$(BUNDLE_ID_PREFIX)
// macOS: a team-prefixed group needs no provisioning-profile authorization, so the sandboxed share extension can reach the inbox.
INBOX_GROUP_IDENTIFIER = $(APP_GROUP_IDENTIFIER)
INBOX_GROUP_IDENTIFIER[sdk=macosx*] = $(TeamIdentifierPrefix)$(APP_GROUP_IDENTIFIER)
ICLOUD_CONTAINER_IDENTIFIER = iCloud.$(BUNDLE_ID_PREFIX)
// Locally signed Release builds use CloudKit Production, like Sparkle and TestFlight builds, so every install shares one library. Debug stays on Development.
ICLOUD_CONTAINER_ENVIRONMENT = Development
ICLOUD_CONTAINER_ENVIRONMENT[config=Release] = Production
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
IPHONEOS_DEPLOYMENT_TARGET = 18.0
MACOSX_DEPLOYMENT_TARGET = 15.0
APP_DISPLAY_NAME = PocketMe
MARKETING_VERSION = 0.1.12
CURRENT_PROJECT_VERSION = 15
// Sparkle update signing key (public half). Generated by Release/publish_mac.sh keys; the private half stays in the Keychain.
SPARKLE_PUBLIC_ED_KEY = wRWp2jYZVGnS3qHkM8SLcy9Oq0EFFSlG3PHKj3/SODY=
#include? "Local.xcconfig"
