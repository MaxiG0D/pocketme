// Set your Apple Developer Team ID and identifiers before running on a device.
DEVELOPMENT_TEAM =
BUNDLE_ID_PREFIX = com.maxigariepy.pocketme
APP_GROUP_IDENTIFIER = group.$(BUNDLE_ID_PREFIX)
ICLOUD_CONTAINER_IDENTIFIER = iCloud.$(BUNDLE_ID_PREFIX)
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
IPHONEOS_DEPLOYMENT_TARGET = 18.0
MACOSX_DEPLOYMENT_TARGET = 15.0
APP_DISPLAY_NAME = PocketMe
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
// Sparkle update signing key (public half). Generated by Release/publish_mac.sh keys; the private half stays in the Keychain.
SPARKLE_PUBLIC_ED_KEY =
#include? "Local.xcconfig"
